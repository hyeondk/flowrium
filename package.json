{
  "name": "flowrium",
  "version": "0.4.0",
  "private": true,
  "description": "프로젝트마다 독립된 AI 업무 대화를 운영하는 데스크톱 앱",
  "author": "hyeondk",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev:vite": "vite --host 127.0.0.1",
    "dev": "node scripts/dev.cjs",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "check": "npm run build && npm test",
    "dist": "npm run build && node scripts/package-desktop.cjs",
    "dist:mac": "npm run build && node scripts/package-desktop.cjs --mac",
    "dist:win": "npm run build && node scripts/package-desktop.cjs --win",
    "postinstall": "node electron/terminal.cjs --prepare",
    "prepare:runtime": "node scripts/prepare-runtime.cjs"
  },
  "dependencies": {
    "@openai/codex": "0.167.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "markdown-it": "15.0.3",
    "node-pty": "1.1.0",
    "pdfjs-dist": "6.5.438",
    "pptxgenjs": "4.0.1",
    "web-push": "4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "45.3.1",
    "electron-builder": "26.18.0",
    "lucide-react": "1.72.0",
    "playwright": "^1.58.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "build": {
    "appId": "io.github.hyeondk.flowrium",
    "productName": "Flowrium",
    "beforePack": "./scripts/build-native.cjs",
    "artifactName": "Flowrium-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/flowrium.png",
      "package.json",
      "!node_modules/node-pty/{third_party,src,build}/**/*",
      "!node_modules/node-pty/**/*.pdb",
      "!node_modules/node-pty/prebuilds/{win32-arm64,darwin-x64}/**/*",
      "!node_modules/node-pty/prebuilds/!(*-${arch})/**/*",
      "!electron/native/*.swift",
      "!electron/native/*.plist"
    ],
    "asarUnpack": [
      "node_modules/@openai/**/*",
      "node_modules/node-pty/**/*",
      "electron/native/flowrium-pim"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "assets/flowrium.icns",
      "hardenedRuntime": true,
      "extendInfo": {
        "NSHumanReadableCopyright": "Flowrium",
        "NSMicrophoneUsageDescription": "음성으로 작업 요청을 입력할 때 마이크를 사용합니다.",
        "NSAppleEventsUsageDescription": "사용자가 연결한 메일 앱의 자료를 읽고 승인한 연결 주소를 보냅니다.",
        "NSCalendarsFullAccessUsageDescription": "연결한 캘린더를 읽고 검토한 일정 변경을 적용합니다.",
        "NSCalendarsUsageDescription": "연결한 캘린더를 읽고 검토한 일정 변경을 적용합니다."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/flowrium.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "hyeondk",
      "repo": "flowrium",
      "releaseType": "draft"
    },
    "dmg": {
      "sign": true
    },
    "npmRebuild": false,
    "extraResources": [
      {
        "from": ".flowrium-tmp/runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "overrides": {
    "image-size": "2.0.4"
  }
}
